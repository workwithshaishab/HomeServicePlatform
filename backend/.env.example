# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (psycopg2 / SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://gharsewa_user:changeme@localhost:5432/gharsewa

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# CORS - comma separated origins, or * for dev
ALLOWED_ORIGINS=*
